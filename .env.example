# Copy to `.env` and adjust. Real environment variables take precedence over this file.

# Where audio separation runs:
#   modal - on a GPU in YOUR Modal account (fast, ~30-50 s per song; needs `modal token new`
#           and `modal deploy deploy/modal_app.py` once - see README)
#   local - on this computer, no account needed (slow: ~10-15 min per song on a laptop)
#   auto  - modal if Modal credentials are configured, else local (default)
KARAOKIT_SEPARATION=auto

# Modal credentials, if you don't use `modal token new` (which writes ~/.modal.toml instead).
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# Name of your deployed Modal app (only change it if you renamed it in deploy/modal_app.py).
# KARAOKIT_MODAL_APP=karaoke-he-separation

# Import audio from YouTube links. OFF by default: downloading from YouTube is against
# YouTube's terms of service. Enable it only if you accept that for your own use.
KARAOKIT_ENABLE_YOUTUBE=0

# Where songs are processed and finished videos are kept (default: the project folder, or
# ~/.karaokit when installed as a package; /data in Docker).
# KARAOKIT_DATA_DIR=/path/to/karaokit-data

# Shown to LRCLIB (the free lyrics database) in the User-Agent, as it asks of every client.
# KARAOKIT_HOMEPAGE=https://github.com/you/karaokit

# Use a different font for everything drawn into the video.
# KARAOKIT_FONT_PATH=/path/to/font.ttf
